<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package Name="MinecraftTools" Manufacturer="MitaHill" Version="$(var.Version)"
           UpgradeCode="A88CFA87-8467-421D-9742-31ADB9BD8C7E" Scope="perUser"
           InstallerVersion="500">
    <MajorUpgrade DowngradeErrorMessage="A newer version of MinecraftTools is already installed." />
    <MediaTemplate EmbedCab="yes" />
    <StandardDirectory Id="LocalAppDataFolder">
      <Directory Id="UserPrograms" Name="Programs">
        <Directory Id="INSTALLFOLDER" Name="MinecraftTools">
          <Component Id="LauncherPackage" Guid="957B5526-9542-4AB1-92FA-5996A00DE8D6">
            <File Id="LauncherExecutable" Source="$(var.SourceDir)\MinecraftToolsLauncher.exe" />
            <File Source="$(var.SourceDir)\bootstrap.json" />
            <File Source="$(var.SourceDir)\bootstrap.tar.gz" />
            <RegistryValue Root="HKCU" Key="Software\MitaHill\MinecraftTools" Name="Installed" Value="1" Type="integer" KeyPath="yes" />
            <RemoveFolder Id="RemoveInstallFolder" On="uninstall" />
          </Component>
        </Directory>
      </Directory>
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder">
      <Component Id="LauncherShortcut" Guid="084D0FAD-D723-40B4-A941-7452A47DD557">
        <Shortcut Id="StartMenuLauncher" Name="MinecraftTools" Target="[#LauncherExecutable]" WorkingDirectory="INSTALLFOLDER" />
        <RegistryValue Root="HKCU" Key="Software\MitaHill\MinecraftTools" Name="StartMenu" Value="1" Type="integer" KeyPath="yes" />
      </Component>
    </StandardDirectory>
    <Feature Id="Main" Title="MinecraftTools">
      <ComponentRef Id="LauncherPackage" />
      <ComponentRef Id="LauncherShortcut" />
    </Feature>
  </Package>
</Wix>
