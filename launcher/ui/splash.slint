import { ProgressIndicator } from "std-widgets.slint";

component ActionButton inherits Rectangle {
    in property <string> text;
    callback clicked;

    width: max(88px, label.preferred-width + 32px);
    height: 32px;
    border-radius: 4px;
    border-width: 1px;
    border-color: #6a6a6a;
    background: touch.has-hover ? #4a4a4a : #333333;

    label := Text {
        width: 100%;
        height: 100%;
        text: root.text;
        color: #ffffff;
        font-size: 13px;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.clicked();
        }
    }

    animate background {
        duration: 120ms;
    }
}

export component SplashWindow inherits Window {
    in property <string> status-text: "正在启动";
    // 0..1 显示实际进度，负数表示进度未知。
    in property <float> progress: -1;
    in property <bool> show-progress: false;
    in property <bool> error-mode: false;
    in property <bool> can-retry: false;
    in property <string> error-title: "";
    in property <string> error-detail: "";
    in property <string> error-report: "";
    callback retry-clicked;
    callback exit-clicked;

    title: "MinecraftTools";
    no-frame: true;
    width: 760px;
    height: 300px;
    background: #111111;

    Image {
        width: 100%;
        height: 100%;
        source: @image-url("splash.png");
        image-fit: cover;
    }

    VerticalLayout {
        visible: !root.error-mode;
        alignment: end;
        padding-right: 16px;
        padding-bottom: 12px;
        spacing: 6px;

        HorizontalLayout {
            alignment: end;
            ProgressIndicator {
                visible: root.show-progress;
                width: 240px;
                height: 6px;
                progress: max(root.progress, 0);
                indeterminate: root.progress < 0;
            }
        }

        HorizontalLayout {
            alignment: end;
            Rectangle {
                height: 26px;
                border-radius: 4px;
                background: #000000a6;
                HorizontalLayout {
                    padding-left: 10px;
                    padding-right: 10px;
                    Text {
                        text: root.status-text;
                        color: #ffffff;
                        font-size: 12px;
                        vertical-alignment: center;
                    }
                }
            }
        }
    }

    Text {
        visible: !root.error-mode;
        x: 12px;
        y: parent.height - 24px;
        text: "MinecraftTools Launcher · Built with Slint";
        color: #ffffff99;
        font-size: 10px;
    }

    Rectangle {
        visible: root.error-mode;
        width: 100%;
        height: 100%;
        background: #000000ee;

        VerticalLayout {
            padding: 24px;
            spacing: 10px;
            alignment: center;
            Text {
                text: root.error-title;
                color: #ffffff;
                font-size: 17px;
                font-weight: 600;
            }
            Text {
                text: root.error-detail;
                color: #d0d0d0;
                font-size: 12px;
                wrap: word-wrap;
            }
            Text {
                text: root.error-report;
                color: #a0a0a0;
                font-size: 11px;
                wrap: word-wrap;
            }
            HorizontalLayout {
                alignment: end;
                spacing: 8px;
                ActionButton {
                    visible: root.can-retry;
                    text: "重试";
                    clicked => {
                        root.retry-clicked();
                    }
                }
                ActionButton {
                    text: "退出";
                    clicked => {
                        root.exit-clicked();
                    }
                }
            }
        }
    }
}
