# 复制到 /opt/minecraft-tools/control-server/deploy.env，chmod 600。
# 数据目录留在 /srv 下，跟 compose 目录分开；CI 的发布上传仍写 releases。
TRIAL_DIR=/srv/minecrafttools-integration/tls-node-trial
CONTROL_IMAGE_TAG=2026-11-26-1
CONTROL_HTTP_PORT=18765
CONTROL_MIN_FRPC_VERSION=0.72.0
CONTROL_RELEASE_DIRECTORY=/srv/minecrafttools-integration/tls-node-trial/releases
CONTROL_NODE_HUB_TLS_DIR=/srv/minecrafttools-integration/tls-node-trial/hub-tls
CONTROL_NODE_HUB_BIND=0.0.0.0
CONTROL_NODE_HUB_PUBLIC_PORT=19443
CONTROL_SCANNER_ENABLED=1
CONTROL_LOBBY_TARGETS=154.219.110.199:30001,hk-1.mitahill.com:33001,hk-1.mitahill.com:33002
CONTROL_TRUSTED_PROXIES=127.0.0.1,172.19.0.1
CONTROL_ADMIN_USERS_FILE=/run/minecrafttools-admin/accounts.json
